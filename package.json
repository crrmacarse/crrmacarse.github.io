{
  "name": "portfolio",
  "homepage": "https://crrmacarse.github.io/",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "start:dev": "webpack serve --config=webpack.web.config.js --mode development",
    "build": "webpack --config=webpack.web.config.js --mode production",
    "hot": "webpack-dev-server --open --hot --profile --progress --colors --config=webpack.config.babel.js --env=hot",
    "dev": "webpack --hot --profile --progress --config=webpack.config.babel.js --env=development",
    "prod": "webpack --profile --progress --config=webpack.config.babel.js --env=production",
    "build:stats": "webpack --profile --json --config=webpack.config.babel.js --env=production > compilation-stats.json",
    "analyze": "webpack-bundle-analyzer compilation-stats.json dist",
    "lint": "eslint --ext .js,.ts,.tsx --ignore-pattern node_modules/",
    "lint:prod": "eslint --ext .js,.ts,.tsx src --ignore-pattern src/**/*.test.tsx",
    "test": "jest --verbose --colors --coverage",
    "test:watch": "jest --colors --watch",
    "test-update": "jest --updateSnapshot",
    "sitemap": "npx babel-node sitemap-builder.js",
    "copy": "cp -r essentials/* dist",
    "copy:windows": "copy essentials/* dist",
    "pre-deploy": "npm run test && npm run prod && npm run sitemap && npm run copy",
    "pre-deploy:windows": "npm run test && npm run prod && npm run sitemap && npm run copy:windows",
    "serve:prod": "serve dist",
    "deploy": "npm run pre-deploy && gh-pages -b master -d dist",
    "deploy:windows": "npm run pre-deploy:windows && gh-pages -b master -d dist"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^1.2.26",
    "@fortawesome/free-brands-svg-icons": "^5.12.0",
    "@fortawesome/free-regular-svg-icons": "^5.12.0",
    "@fortawesome/free-solid-svg-icons": "^5.12.0",
    "@fortawesome/react-fontawesome": "^0.1.8",
    "@react-spring/web": "^9.7.5",
    "core-js": "^3.6.4",
    "dotenv-webpack": "^8.1.0",
    "final-form": "^4.18.7",
    "firebase": "^7.7.0",
    "i18next": "^23.12.1",
    "i18next-browser-languagedetector": "^8.0.0",
    "lodash": "^4.17.15",
    "nprogress": "^0.2.0",
    "placeholder-loading": "^0.2.5",
    "raf": "^3.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-final-form": "^6.3.5",
    "react-helmet": "^5.2.1",
    "react-i18next": "^14.1.3",
    "react-image": "^4.1.0",
    "react-redux": "^7.1.3",
    "react-scripts": "3.3.0",
    "react-spring": "^8.0.27",
    "react-use-gesture": "^9.1.3",
    "regenerator-runtime": "^0.13.3",
    "typesafe-actions": "^5.1.0",
    "vec-la": "^1.5.0"
  },
  "main": "webpack.config.js",
  "devDependencies": {
    "@babel/cli": "^7.25.9",
    "@babel/core": "^7.26.0",
    "@babel/helper-compilation-targets": "^7.10.4",
    "@babel/preset-env": "^7.24.7",
    "@babel/preset-react": "^7.24.7",
    "@babel/preset-typescript": "^7.24.7",
    "@fullhuman/postcss-purgecss": "^2.0.5",
    "@types/jest": "^24.0.23",
    "@types/lodash": "^4.14.149",
    "@types/node": "^12.12.17",
    "@types/nprogress": "^0.2.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-helmet": "^5.0.15",
    "@types/react-redux": "^7.1.7",
    "@types/react-router-dom": "^5.1.3",
    "@types/react-test-renderer": "^16.9.2",
    "@types/redux-logger": "^3.0.7",
    "@webpack-cli/serve": "^2.0.5",
    "autoprefixer": "^10.4.19",
    "babel-loader": "^9.1.3",
    "brotli-webpack-plugin": "^1.1.0",
    "clean-webpack-plugin": "^3.0.0",
    "compression-webpack-plugin": "^3.1.0",
    "css-loader": "^7.1.2",
    "eslint": "^9.6.0",
    "eslint-webpack-plugin": "^4.2.0",
    "file-loader": "^6.2.0",
    "gh-pages": "^2.2.0",
    "html-webpack-plugin": "^5.6.0",
